{
  "name": "swarm-builder",
  "version": "0.1.0",
  "description": "Embeddable cursor-swarm page rebuild library",
  "license": "MIT",
  "author": "tycon",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yancongya/swarm-builder.git"
  },
  "homepage": "https://github.com/yancongya/swarm-builder#readme",
  "bugs": "https://github.com/yancongya/swarm-builder/issues",
  "keywords": [
    "cursor",
    "swarm",
    "animation",
    "page-rebuild",
    "overlay",
    "demo",
    "vanilla"
  ],
  "type": "module",
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "main": "./dist/swarm-builder.cjs",
  "module": "./dist/swarm-builder.es.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/swarm-builder.es.js",
      "require": "./dist/swarm-builder.cjs"
    },
    "./tune": {
      "types": "./dist/types/tune/index.d.ts",
      "import": "./dist/swarm-builder.tune.es.js",
      "require": "./dist/swarm-builder.tune.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.tune.config.ts && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "verify": "node tools/verify.mjs",
    "verify:consumer": "node tools/consumer.mjs",
    "prepublishOnly": "npm run typecheck && npm run build && npm run verify && npm run verify:consumer"
  },
  "devDependencies": {
    "playwright": "^1.54.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  },
  "unpkg": "./dist/swarm-builder.iife.js",
  "jsdelivr": "./dist/swarm-builder.iife.js",
  "sideEffects": false,
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
