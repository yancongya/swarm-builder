{
  "name": "swarm-builder",
  "version": "0.1.0",
  "description": "Embeddable cursor-swarm page rebuild library",
  "type": "module",
  "files": [
    "dist"
  ],
  "module": "./dist/swarm-builder.js",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/swarm-builder.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "playwright": "^1.54.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.6"
  }
}
